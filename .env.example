# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.

# Required. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Forces one model instead of the free-tier fallback chain in
# lib/openrouter.ts (openrouter/free -> nvidia/nemotron-3-super-120b-a12b:free
# -> minimax/minimax-m3:free). Any paid model needs credits on the account.
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional. Sent as the HTTP-Referer header for OpenRouter dashboard attribution.
# Set this to the deployed URL in production.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
